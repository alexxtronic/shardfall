# Godot
.godot/
*.translation
export_presets.cfg.bak
/build/
/export/

# Python / tools
__pycache__/
*.pyc
.venv/

# Blender backups and render scratch
*.blend1
*.blend2
art/**/review/tmp/
art/**/cache/

# Big source exports stay out (Tripo GLBs live in Downloads)
art/**/source/*.glb
art/**/source/*.zip

# OS / editor
.DS_Store
*.swp
*~

# Review renders: only each art group's final round is kept in git
art/ambron_buildings/review/round[1-3]/
art/ambron_vehicles/review/round[1-3]/
art/neutral/review/round[1-6]/
art/void_buildings/review/r0/
art/void_buildings/review/r1/
art/void_buildings/review/fast/

# Scratch debugging probes
tools/probe.*

# Tripo pipeline: raw Tripo exports are big source files (the harvester alone is 62 MB),
# and only the final review round is kept
art/tripo/raw/
art/tripo/review/inspect/
art/tripo/review/round1/
art/tripo/review/round2/

# Local Claude Code settings
.claude/settings.local.json

# Kiln runtime state: build cache, review runs and lock files (the locks hold local session tokens)
.kiln/cache/
.kiln/review/

# signing keys and store credentials never go in git
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
.env
.env.*
export_credentials.cfg
