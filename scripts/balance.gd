class_name Balance
extends Node
## Headless balance checks (run: Godot --headless --path . -- --balance).
##  1. Mirror battles: each Ambron unit against its Void counterpart, equal value.
##  2. Mixed armies: the same random composition for both races.
##  3. Random armies: different random compositions of equal value, many times.
##  4. Counter table: how each slot fares against each other slot (one race).
##  5. Full games: Ambron bot against Void bot on the real map.
## Writes docs/BALANCE.md and prints a summary.

const BUDGET := 1500.0
const SLOTS := ["infantry", "heavy", "vehicle_flame", "vehicle_missile", "air_light", "air_heavy", "special"]

var args: PackedStringArray
var report: Array = []
var quick: bool = false
var verbose: bool = false


func _ready() -> void:
	quick = args.has("--quick")
	if args.has("--game"):
		call_deferred("_one_game")
	else:
		call_deferred("_run")


## One verbose bot game: prints a timeline every two minutes.
func _one_game() -> void:
	var races := ["ambron", "void"]
	for a in args:
		if a.begins_with("--races="):
			races = Array(a.substr(8).split(","))
	verbose = true
	_full_game(races, 1)
	get_tree().quit()


func _log(s: String) -> void:
	print(s)
	report.append(s)


func _run() -> void:
	var t0 := Time.get_ticks_msec()
	seed(12345)
	_log("# Shardfall balance report")
	_log("")
	_log("Generated by `scripts/balance.gd` (`Godot --headless --path . -- --balance`). Each battle: two armies of equal value (crystals + %.1f x slime) on open ground, attack-moving into each other. Win rate is Ambron's; 50%% is perfect parity." % Defs.SLIME_VALUE)
	_log("")
	var trials := 4 if quick else 10
	# 1. mirror slot battles
	_log("## 1. Mirror battles (value %d each side)" % int(BUDGET))
	_log("")
	_log("Margin is Ambron's value left minus Void's, as a share of the starting value: 0% is a dead heat, +100% a flawless Ambron win.")
	_log("")
	_log("| Slot | Ambron unit | Void unit | Ambron win rate | Avg margin |")
	_log("|---|---|---|---|---|")
	var all_w := 0.0
	var all_n := 0
	for slot in SLOTS:
		var res := _series([[slot, 1.0]], [[slot, 1.0]], trials)
		all_w += res[0] * trials
		all_n += trials
		_log("| %s | %s | %s | %d%% | %+d%% |" % [slot, Defs.units[Defs.unit_id("ambron", slot)]["name"], Defs.units[Defs.unit_id("void", slot)]["name"], int(res[0] * 100.0), int(res[1] * 100.0)])
	_log("")
	# 2. mixed, same comp
	_log("## 2. Mixed armies, same composition")
	_log("")
	var mixes := [
		[["infantry", 0.6], ["heavy", 0.4]],
		[["infantry", 0.4], ["vehicle_flame", 0.3], ["vehicle_missile", 0.3]],
		[["heavy", 0.3], ["vehicle_missile", 0.3], ["air_light", 0.2], ["air_heavy", 0.2]],
		[["infantry", 0.3], ["heavy", 0.2], ["special", 0.5]],
	]
	_log("| Composition | Ambron win rate | Avg margin |")
	_log("|---|---|---|")
	for mix in mixes:
		var res := _series(mix, mix, trials)
		all_w += res[0] * trials
		all_n += trials
		var names: Array = []
		for m in mix:
			names.append("%s %d%%" % [m[0], int(m[1] * 100)])
		_log("| %s | %d%% | %+d%% |" % [", ".join(names), int(res[0] * 100.0), int(res[1] * 100.0)])
	_log("")
	# 3. random different comps
	var n_rand := 16 if quick else 40
	var rw := 0.0
	var rm := 0.0
	for i in n_rand:
		var a := _random_mix()
		var b := _random_mix()
		# play both ways round so composition luck cancels out
		var r1 := _battle(a, b, i)
		var r2 := _battle(b, a, i + 1000)
		rw += (r1[0] + r2[0]) * 0.5
		rm += (r1[1] + r2[1]) * 0.5
	_log("## 3. Random armies")
	_log("")
	_log("%d random composition pairs, each played with the races swapped: Ambron wins **%d%%**, average margin %+d%%." % [n_rand, int(rw / n_rand * 100.0), int(rm / n_rand * 100.0)])
	_log("")
	all_w += rw
	all_n += n_rand
	_log("**Overall Ambron win rate across all battles: %d%%** (target 50%%, within about 10 points is noise at these sample sizes)." % int(all_w / all_n * 100.0))
	_log("")
	# 4. counter table
	_log("## 4. Counter table (Ambron vs Ambron, equal value): row's margin against column")
	_log("")
	var head := "| | " + " | ".join(SLOTS) + " |"
	_log(head)
	var sep := "|---|"
	for s in SLOTS:
		sep += "---|"
	_log(sep)
	for a in SLOTS:
		var row := "| %s |" % a
		for b in SLOTS:
			if a == b:
				row += " - |"
				continue
			var res := _series_race([[a, 1.0]], [[b, 1.0]], 2 if quick else 3, "ambron", "ambron")
			row += " %+d%% |" % int(res[1] * 100.0)
		_log(row)
	_log("")
	# 5. full games
	var games := 0 if args.has("--nogames") else (2 if quick else 6)
	_log("## 5. Full games, bot against bot (normal)")
	_log("")
	_log("| Game | P1 | P2 | Winner | Time |")
	_log("|---|---|---|---|---|")
	var wins := {"ambron": 0, "void": 0, "none": 0}
	for g in games:
		var races := ["ambron", "void"] if g % 2 == 0 else ["void", "ambron"]
		var res := _full_game(races, g)
		var wr: String = "none" if res[0] < 0 else races[res[0]]
		wins[wr] += 1
		_log("| %d | %s | %s | %s | %s |" % [g + 1, races[0], races[1], wr, UiKit.fmt_time(res[1])])
	_log("")
	_log("Ambron %d, Void %d, unfinished %d." % [wins["ambron"], wins["void"], wins["none"]])
	_log("")
	_log("Run time: %.1f s" % ((Time.get_ticks_msec() - t0) / 1000.0))
	var f := FileAccess.open("res://docs/BALANCE.md", FileAccess.WRITE)
	if f:
		f.store_string("\n".join(report) + "\n")
		f.close()
	print("BALANCE DONE")
	get_tree().quit()


func _random_mix() -> Array:
	var picks: Array = SLOTS.duplicate()
	picks.shuffle()
	var n := randi_range(1, 3)
	var out: Array = []
	var tot := 0.0
	var ws: Array = []
	for i in n:
		var w := randf_range(0.3, 1.0)
		ws.append(w)
		tot += w
	for i in n:
		out.append([picks[i], ws[i] / tot])
	return out


func _series(a: Array, b: Array, n: int) -> Array:
	var wins := 0.0
	var left := 0.0
	for i in n:
		# alternate sides so map position doesn't matter
		var r: Array
		if i % 2 == 0:
			r = _battle(a, b, i)
			wins += r[0]
		else:
			r = _battle_swapped(a, b, i)
			wins += r[0]
		left += r[1]
	return [wins / n, left / n]


func _series_race(a: Array, b: Array, n: int, ra: String, rb: String) -> Array:
	var wins := 0.0
	var margin := 0.0
	for i in n:
		var r := _battle_r(a, b, i, ra, rb, i % 2 == 1)
		wins += r[0]
		margin += r[1]
	return [wins / n, margin / n]


## Ambron army a (left) vs Void army b (right). Returns [ambron_win (0/0.5/1), winner value left].
func _battle(a: Array, b: Array, s: int) -> Array:
	return _battle_r(a, b, s, "ambron", "void", false)


func _battle_swapped(a: Array, b: Array, s: int) -> Array:
	return _battle_r(a, b, s, "ambron", "void", true)


func _battle_r(a: Array, b: Array, s: int, ra: String, rb: String, swap: bool) -> Array:
	seed(s * 7919 + 17)
	var w := World.new()
	add_child(w)
	w.setup({"map": "arena", "visuals": false, "human": -1, "races": [ra, rb], "ai": [false, false], "map_size": 72})
	w.check_victory = false
	var left_x := 22.0
	var right_x := 50.0
	var pa := 0 if not swap else 1
	var pb := 1 if not swap else 0
	# side 0 always gets comp a with race ra
	w.players[0].race = ra
	w.players[1].race = rb
	_spawn_army(w, 0, a, left_x if not swap else right_x, ra)
	_spawn_army(w, 1, b, right_x if not swap else left_x, rb)
	for u in w.units:
		var tx := right_x + 6.0 if u.p.x < 36.0 else left_x - 6.0
		u.cmd_move(Vector2(tx, u.p.y), true)
	var t := 0.0
	var alive := [0, 0]
	while t < 150.0:
		w.step(0.05)
		t += 0.05
		alive = [0, 0]
		for u in w.units:
			if not u.dead:
				alive[u.owner_id] += 1
		if alive[0] == 0 or alive[1] == 0:
			break
	var v := [0.0, 0.0]
	for u in w.units:
		if not u.dead:
			v[u.owner_id] += Defs.value_of(u.def_id) * (u.hp / u.max_hp)
	w.queue_free()
	var res := 0.5
	if alive[0] > 0 and alive[1] == 0:
		res = 1.0
	elif alive[1] > 0 and alive[0] == 0:
		res = 0.0
	else:
		res = 1.0 if v[0] > v[1] * 1.1 else (0.0 if v[1] > v[0] * 1.1 else 0.5)
	# margin: side 0's value left minus side 1's, as a share of the budget
	return [res, (v[0] - v[1]) / BUDGET]


func _spawn_army(w: World, pid: int, mix: Array, x: float, race: String) -> void:
	var list: Array = []
	var part := {}
	for m in mix:
		var id := Defs.unit_id(race, m[0])
		var val := Defs.value_of(id)
		var exact := BUDGET * float(m[1]) / val
		var n := int(floor(exact))
		for i in n:
			list.append(id)
		# the leftover value becomes one unit with part of its health,
		# so both armies are worth exactly the same
		if exact - n > 0.05:
			list.append(id)
			part[list.size() - 1] = exact - n
	var cols := int(ceil(sqrt(list.size() * 2.2)))
	for i in list.size():
		var col := i % cols
		var row := i / cols
		var d: Dictionary = Defs.units[list[i]]
		var sp: float = float(d["radius"]) * 2.4 + 0.3
		var dirx := -1.0 if x < 36.0 else 1.0
		var at := Vector2(x + dirx * row * 1.6 + randf_range(-0.2, 0.2), 36.0 + (col - cols * 0.5) * sp + randf_range(-0.2, 0.2))
		var u: Unit = w.spawn_unit(list[i], pid, at)
		if part.has(i):
			u.hp = u.max_hp * float(part[i])


## A full bot-vs-bot game on the real map. Returns [winner or -1, game time].
func _full_game(races: Array, s: int) -> Array:
	seed(s * 31 + 5)
	var w := World.new()
	add_child(w)
	w.setup({"map": "standard", "visuals": false, "human": -1, "races": races, "ai": [true, true], "difficulty": "normal"})
	var t := 0.0
	var limit := 40.0 * 60.0
	var next_log := 0.0
	while t < limit and not w.over:
		w.step(0.1)
		t += 0.1
		if verbose and t >= next_log:
			next_log += 120.0
			_timeline(w)
	var winner := w.winner if w.over else -1
	var tt := w.time
	print("full game %d: %s vs %s -> %s at %s (P1 made %d, P2 made %d; gathered %d / %d)" % [s, races[0], races[1], str(winner), UiKit.fmt_time(tt), w.players[0].units_made, w.players[1].units_made, w.players[0].gathered_m, w.players[1].gathered_m])
	w.queue_free()
	return [winner, tt]


func _timeline(w: World) -> void:
	var line := "%s" % UiKit.fmt_time(w.time)
	for pl in w.players:
		var workers := 0
		var army := 0
		var army_sup := 0
		for u in w.units:
			if u.owner_id == pl.id and not u.dead:
				if u.is_worker:
					workers += 1
				else:
					army += 1
					army_sup += u.supply
		var bs := {}
		for b in w.buildings:
			if b.owner_id == pl.id and not b.dead:
				bs[b.slot] = int(bs.get(b.slot, 0)) + 1
		var st := "-"
		for ai in w.ais:
			if ai.pid == pl.id:
				st = ai.state
		line += " | P%d %s m%d s%d w%d army%d(%d sup) sup %d/%d lost%d %s %s" % [pl.id + 1, pl.race.substr(0, 1), pl.minerals, pl.slime, workers, army, army_sup, w.supply_used(pl.id), w.supply_cap(pl.id), pl.units_lost, st, str(bs)]
	print(line)
