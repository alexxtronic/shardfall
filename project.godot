; Engine configuration file.

config_version=5

[application]

config/name="Shardfall"
config/version="1.0"
config/description="A mobile real-time strategy game: Ambron robots against the Void swarm."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.02, 0.015, 0.035, 1)
boot_splash/image="res://assets/ui/splash.png"
boot_splash/fullsize=false
boot_splash/use_filter=true

[autoload]

Defs="*res://scripts/defs.gd"
Prefs="*res://scripts/prefs.gd"
Profile="*res://scripts/profile.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/dpi/allow_hidpi=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
textures/vram_compression/import_etc2_astc=true
